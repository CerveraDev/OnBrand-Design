{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onbrand.design/tools/rider-campaign-runtime/campaign.schema.json",
  "title": "Rider Campaign Runtime Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "manifest", "modules", "static_blocks", "variants"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "output_dir"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "output_dir": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "preview_text": { "type": "string" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "variant": { "const": "default" },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["text", "safe_rich_text", "url", "image"] },
                "value": { "type": "string" },
                "href": { "type": "string" },
                "asset_id": { "type": "string" },
                "src": { "type": "string" },
                "alt": { "type": "string" },
                "title": { "type": "string" },
                "role": { "type": "string" }
              },
              "oneOf": [
                {
                  "properties": { "kind": { "enum": ["text", "safe_rich_text"] } },
                  "required": ["value"],
                  "not": { "anyOf": [{ "required": ["href"] }, { "required": ["asset_id"] }, { "required": ["src"] }] }
                },
                {
                  "properties": { "kind": { "const": "url" } },
                  "required": ["href"],
                  "not": { "anyOf": [{ "required": ["value"] }, { "required": ["asset_id"] }, { "required": ["src"] }] }
                },
                {
                  "properties": { "kind": { "const": "image" } },
                  "oneOf": [
                    { "required": ["asset_id"], "not": { "required": ["src"] } },
                    { "required": ["src"], "not": { "required": ["asset_id"] } }
                  ],
                  "not": { "anyOf": [{ "required": ["value"] }, { "required": ["href"] }] }
                }
              ]
            }
          }
        }
      }
    },
    "static_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["include", "exclude"] }
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branded": { "type": "boolean" },
        "outside_broker": { "type": "boolean" },
        "agents": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "outside_broker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "social": { "type": "string" },
        "headshot": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            { "required": ["src"], "not": { "required": ["asset_id"] } },
            { "required": ["asset_id"], "not": { "required": ["src"] } }
          ],
          "properties": {
            "src": { "type": "string" },
            "asset_id": { "type": "string" },
            "alt": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "role"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_mode": { "enum": ["relative-review", "hosted-deployment"] },
        "hosted_asset_base_url": { "type": "string", "format": "uri" }
      },
      "allOf": [
        {
          "if": { "properties": { "asset_mode": { "const": "hosted-deployment" } }, "required": ["asset_mode"] },
          "then": { "required": ["hosted_asset_base_url"] }
        },
        {
          "if": { "properties": { "asset_mode": { "const": "relative-review" } }, "required": ["asset_mode"] },
          "then": { "not": { "required": ["hosted_asset_base_url"] } }
        }
      ]
    }
  }
}
