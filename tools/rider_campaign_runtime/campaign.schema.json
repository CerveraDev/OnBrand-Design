{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onbrand.design/tools/rider-campaign-runtime/campaign.schema.json",
  "title": "Rider Campaign Runtime Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build", "copy_allocation", "campaign", "manifest", "modules", "static_blocks", "variants"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "variant_policy"],
      "properties": {
        "mode": { "enum": ["composition-preview", "smoke-test", "release-build"] },
        "representative_variant": {
          "type": "string",
          "pattern": "^(branded|outside-broker-customizable|agent-[a-z0-9]+(?:-[a-z0-9]+)*)$",
          "default": "branded"
        },
        "variant_policy": { "enum": ["single", "all", "changed-surface-expanded"] },
        "changed_surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "agent-roster",
              "agent-data",
              "agent-footer-assets",
              "footer-renderer",
              "footer-data",
              "scaffold-footer-structure"
            ]
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "composition-preview" } }, "required": ["mode"] },
          "then": {
            "properties": { "variant_policy": { "const": "single" } },
            "not": { "required": ["changed_surfaces"], "properties": { "changed_surfaces": { "minItems": 1 } } }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "release-build" } }, "required": ["mode"] },
          "then": {
            "properties": { "variant_policy": { "const": "all" } },
            "not": { "required": ["changed_surfaces"], "properties": { "changed_surfaces": { "minItems": 1 } } }
          }
        },
        {
          "if": { "properties": { "variant_policy": { "const": "changed-surface-expanded" } }, "required": ["variant_policy"] },
          "then": {
            "properties": { "mode": { "const": "smoke-test" }, "changed_surfaces": { "minItems": 1 } },
            "required": ["changed_surfaces"]
          }
        },
        {
          "if": {
            "not": {
              "properties": { "variant_policy": { "const": "changed-surface-expanded" } },
              "required": ["variant_policy"]
            }
          },
          "then": {
            "not": { "required": ["changed_surfaces"], "properties": { "changed_surfaces": { "minItems": 1 } } }
          }
        }
      ]
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_version",
        "plan_id",
        "status",
        "approved_by",
        "approved_at",
        "representative_variant",
        "selected_module_codes",
        "static_block_decisions"
      ],
      "properties": {
        "plan_version": { "const": "1.0" },
        "plan_id": { "type": "string", "minLength": 1 },
        "status": { "const": "approved" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "minLength": 1 },
        "representative_variant": {
          "type": "string",
          "pattern": "^(branded|outside-broker-customizable|agent-[a-z0-9]+(?:-[a-z0-9]+)*)$"
        },
        "selected_module_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "selected_hero_configuration": {
          "type": "string",
          "minLength": 1
        },
        "selected_modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "scaffold_module_id", "module_type"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "scaffold_module_id": { "type": "string", "minLength": 1 },
              "module_type": { "enum": ["header", "hero", "body", "static"] },
              "includes_header": { "type": "boolean" },
              "locked": { "type": "boolean" }
            }
          }
        },
        "static_block_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "scaffold_module_id", "decision"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "scaffold_module_id": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["include", "exclude"] }
            }
          }
        },
        "editable_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "scaffold_module_id", "slot", "slot_type", "operations", "required_approvals"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "scaffold_module_id": { "type": "string", "minLength": 1 },
              "slot": { "type": "string", "minLength": 1 },
              "slot_type": { "type": "string", "minLength": 1 },
              "operations": { "type": "array", "items": { "type": "string" } },
              "required_approvals": { "type": "array", "items": { "type": "string" } },
              "required": { "type": "boolean" },
              "omit_if_missing": { "type": "boolean" },
              "annotation_id": { "type": "string" }
            }
          }
        },
        "required_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "scaffold_module_id", "slot", "required_approvals", "image_aspect_ratio"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "scaffold_module_id": { "type": "string", "minLength": 1 },
              "slot": { "type": "string", "minLength": 1 },
              "required_approvals": { "type": "array", "items": { "type": "string" } },
              "image_aspect_ratio": { "type": "string" }
            }
          }
        },
        "compatibility": { "type": "object" },
        "approval_required_before": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "image_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "items"],
      "properties": {
        "version": { "const": "1.0" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image_id",
              "workflow_type",
              "status",
              "intended_use",
              "environment",
              "source_assets",
              "prompt_record",
              "output",
              "placement"
            ],
            "properties": {
              "image_id": { "type": "string", "minLength": 1 },
              "workflow_type": { "enum": ["grounded-edit", "grounded-generation", "conceptual-generation"] },
              "status": { "enum": ["approved", "candidate", "rejected"] },
              "approved_by": { "type": "string" },
              "approved_at": { "type": "string" },
              "approval_notes": { "type": "string" },
              "intended_use": {
                "type": "object",
                "additionalProperties": false,
                "required": ["module_id", "slot", "role"],
                "properties": {
                  "module_id": { "type": "string", "minLength": 1 },
                  "slot": { "type": "string", "minLength": 1 },
                  "role": { "type": "string", "minLength": 1 },
                  "variant_scope": { "enum": ["all", "representative"] }
                }
              },
              "environment": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "description", "keywords"],
                "properties": {
                  "type": { "enum": ["real-rider", "conceptual"] },
                  "description": { "type": "string", "minLength": 1 },
                  "keywords": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "conceptual_environment_approved": { "type": "boolean" }
                }
              },
              "source_assets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role"],
                  "properties": {
                    "asset_id": { "type": "string", "minLength": 1 },
                    "path": { "type": "string", "minLength": 1 },
                    "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                    "role": {
                      "enum": ["environment-base", "logo-reference", "likeness-reference", "style-reference"]
                    },
                    "required_approval": { "type": "string" },
                    "preserve": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  },
                  "oneOf": [
                    { "required": ["asset_id"], "not": { "required": ["path"] } },
                    { "required": ["path", "sha256"], "not": { "required": ["asset_id"] } }
                  ]
                }
              },
              "prompt_record": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tool", "prompt", "edit_steps", "text_policy"],
                "properties": {
                  "tool": { "type": "string", "minLength": 1 },
                  "model": { "type": "string" },
                  "prompt": { "type": "string", "minLength": 1 },
                  "negative_prompt": { "type": "string" },
                  "edit_steps": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "text_policy": { "enum": ["live-html", "baked-approved", "none"] }
                }
              },
              "output": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src", "sha256", "width", "height", "format"],
                "properties": {
                  "src": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "width": { "type": "integer", "minimum": 1 },
                  "height": { "type": "integer", "minimum": 1 },
                  "format": { "enum": ["png", "jpg", "jpeg", "gif"] }
                }
              },
              "placement": {
                "type": "object",
                "additionalProperties": false,
                "required": ["aspect_ratio", "crop", "focal_point"],
                "properties": {
                  "aspect_ratio": { "type": "string", "minLength": 1 },
                  "crop": { "type": "string", "minLength": 1 },
                  "focal_point": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y"],
                    "properties": {
                      "x": { "type": "number", "minimum": 0, "maximum": 1 },
                      "y": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  },
                  "safe_area": { "type": "string" },
                  "logo_overlay": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "copy_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "plan_id", "status", "approved_by", "approved_at", "content_units"],
      "properties": {
        "version": { "const": "1.0" },
        "plan_id": { "type": "string", "minLength": 1 },
        "status": { "const": "approved" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "minLength": 1 },
        "content_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "content_role", "source", "approval_status", "owner"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "content_role": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "approval_status": { "const": "approved" },
              "owner": {
                "type": "object",
                "additionalProperties": false,
                "required": ["channel"],
                "properties": {
                  "channel": {
                    "enum": ["live-html", "baked-image-text", "alt-text", "metadata", "static", "legal", "footer"]
                  },
                  "module_id": { "type": "string" },
                  "slot": { "type": "string" },
                  "metadata_field": { "type": "string" },
                  "image_workflow_id": { "type": "string" },
                  "static_block_id": { "type": "string" },
                  "variant_scope": { "enum": ["all", "representative"] }
                }
              },
              "reuse_policy": {
                "enum": [
                  "single-use",
                  "intentional-refrain",
                  "required-legal",
                  "static-brand",
                  "required-name",
                  "footer-contact",
                  "metadata-required"
                ]
              },
              "max_occurrences": { "type": "integer", "minimum": 1 },
              "claim_policy": { "enum": ["none", "requires-evidence", "approved-no-evidence-required"] },
              "claim_references": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "declared_text_source": { "enum": ["ocr", "creator-declared"] },
              "notes": { "type": "string" }
            }
          }
        },
        "slot_allocation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module_id", "slot", "content_unit_id", "rendering_type"],
            "properties": {
              "module_id": { "type": "string", "minLength": 1 },
              "slot": { "type": "string", "minLength": 1 },
              "content_unit_id": { "type": "string", "minLength": 1 },
              "rendering_type": { "type": "string", "minLength": 1 }
            }
          }
        },
        "restricted_phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "phrase", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "phrase": { "type": "string", "minLength": 1 },
              "max_occurrences": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "dedupe_exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason", "scope", "applies_to", "approved_by", "approved_at"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "applies_to": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_at": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "output_dir"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "output_dir": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "preview_text": { "type": "string" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "variant": { "const": "default" },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["text", "safe_rich_text", "url", "image", "text_list", "amplified_list"] },
                "value": { "type": "string" },
                "href": { "type": "string" },
                "asset_id": { "type": "string" },
                "src": { "type": "string" },
                "alt": { "type": "string" },
                "title": { "type": "string" },
                "role": { "type": "string" },
                "image_workflow_id": { "type": "string" },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["term", "amplification"],
                        "properties": {
                          "term": { "type": "string", "minLength": 1 },
                          "amplification": { "type": "string", "minLength": 1 }
                        }
                      }
                    ]
                  }
                }
              },
              "oneOf": [
                {
                  "properties": { "kind": { "enum": ["text", "safe_rich_text"] } },
                  "required": ["value"],
                  "not": { "anyOf": [{ "required": ["href"] }, { "required": ["asset_id"] }, { "required": ["src"] }] }
                },
                {
                  "properties": { "kind": { "const": "url" } },
                  "required": ["href"],
                  "not": { "anyOf": [{ "required": ["value"] }, { "required": ["asset_id"] }, { "required": ["src"] }] }
                },
                {
                  "properties": { "kind": { "const": "image" } },
                  "oneOf": [
                    { "required": ["asset_id"], "not": { "required": ["src"] } },
                    { "required": ["src"], "not": { "required": ["asset_id"] } }
                  ],
                  "not": { "anyOf": [{ "required": ["value"] }, { "required": ["href"] }] }
                },
                {
                  "properties": { "kind": { "const": "text_list" }, "items": { "items": { "type": "string" } } },
                  "required": ["items"],
                  "not": { "anyOf": [{ "required": ["value"] }, { "required": ["href"] }, { "required": ["asset_id"] }, { "required": ["src"] }] }
                },
                {
                  "properties": {
                    "kind": { "const": "amplified_list" },
                    "items": {
                      "items": {
                        "type": "object",
                        "required": ["term", "amplification"]
                      }
                    }
                  },
                  "required": ["items"],
                  "not": { "anyOf": [{ "required": ["value"] }, { "required": ["href"] }, { "required": ["asset_id"] }, { "required": ["src"] }] }
                }
              ],
              "allOf": [
                {
                  "if": { "required": ["image_workflow_id"] },
                  "then": {
                    "properties": { "kind": { "const": "image" } },
                    "required": ["src"],
                    "not": { "required": ["asset_id"] }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "static_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["include", "exclude"] }
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branded": { "type": "boolean" },
        "outside_broker": { "type": "boolean" },
        "agents": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "outside_broker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "social": { "type": "string" },
        "headshot": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            { "required": ["src"], "not": { "required": ["asset_id"] } },
            { "required": ["asset_id"], "not": { "required": ["src"] } }
          ],
          "properties": {
            "src": { "type": "string" },
            "asset_id": { "type": "string" },
            "alt": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "role"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_mode": { "enum": ["relative-review", "hosted-deployment"] },
        "hosted_asset_base_url": { "type": "string", "format": "uri" }
      },
      "allOf": [
        {
          "if": { "properties": { "asset_mode": { "const": "hosted-deployment" } }, "required": ["asset_mode"] },
          "then": { "required": ["hosted_asset_base_url"] }
        },
        {
          "if": { "properties": { "asset_mode": { "const": "relative-review" } }, "required": ["asset_mode"] },
          "then": { "not": { "required": ["hosted_asset_base_url"] } }
        }
      ]
    }
  }
}
