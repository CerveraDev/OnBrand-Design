{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CerveraDev/OnBrand-Design/tools/semantic_eval/question_set.schema.json",
  "title": "OnBrand Jev pilot question set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_set_id", "status", "model", "purpose", "privacy", "confidence_routing", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "question_set_id": {"type": "string", "minLength": 1},
    "status": {"const": "calibration-locked"},
    "model": {"type": "string", "pattern": "^jev-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_state_fields", "forbidden_state_fields", "personal_contact_data"],
      "properties": {
        "allowed_state_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_state_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "personal_contact_data": {"const": "forbidden"}
      }
    },
    "confidence_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high", "medium", "low", "production_effect"],
      "properties": {
        "high": {"type": "number", "minimum": 0, "maximum": 1},
        "medium": {"type": "number", "minimum": 0, "maximum": 1},
        "low": {"type": "number", "minimum": 0, "maximum": 1},
        "production_effect": {"const": "none"}
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copy-similarity", "claim-support"],
      "properties": {
        "copy-similarity": {"$ref": "#/$defs/task"},
        "claim-support": {"$ref": "#/$defs/task"}
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_fields", "questions", "decision_policy"],
      "properties": {
        "state_fields": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "instructions", "criteria"],
            "properties": {
              "type": {"enum": ["choice", "noul", "score"]},
              "instructions": {"type": "string", "minLength": 1},
              "criteria": {"type": ["object", "array"]}
            }
          }
        },
        "decision_policy": {
          "type": "object",
          "required": ["production_effect", "evaluation_label", "action_policy"],
          "properties": {
            "production_effect": {"const": "none"},
            "evaluation_label": {"type": "string", "minLength": 1},
            "action_policy": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
